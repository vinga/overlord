#!/usr/bin/env bash
# ovr — Overlord CLI for agents running inside an Overlord session.
# Works on macOS bash 3.2 and Linux bash. Needs curl + python3.

PROG=${0##*/}
BASE="${OVERLORD_HOST:-http://localhost:3173}"

usage() {
  cat <<EOF
Usage: $PROG <command> [args]

Commands:
  whoami                         This session: overlordId, sessionId, cwd
  pin add <url> [options]        Pin a link to this session (or its room)
      --title TEXT               Chip title (default: derived from the URL)
      --kind ticket|pr|branch|link   (default: derived from the URL)
      --room                     Pin to this session's room instead
  pin ls [--room]                List pins (id, kind, title, url)
  pin rm <pinId> [--room]        Remove a pin
  todo add <text> [--agent] [--room]
                                 Add a TODO item to this session (or its room);
                                 the user's unless --agent (then it is yours)
  todo ls [--agent|--user] [--room]
                                 List TODO items (id, [x] done, @owner, text)
  todo assign <id> agent|user [--room]
                                 Hand an item to the agent or the user
  todo done <id> [--room]        Check an item off (marked as done by the agent)
  todo undo <id> [--room]        Uncheck it
  todo rm <id> [--room]          Remove it
  room ls                        List rooms (id, name, sessions, folder); * = this
                                 session's room
  room move <room>               Show this session in another room. <room> is a
                                 room id, name or folder. You keep working in
                                 the same folder — only the grouping changes
  room move --home               Back to the room of the folder it runs in
  mute on|off|status             Mute agents' voice: \`say\` prints its text to
                                 the conversation instead of speaking
  help                           Show this help

Target session: \$OVERLORD_PTY_ID (set by Overlord at spawn), else the
nearest ancestor process Overlord knows. Override: --session <overlordId>.
Server: \$OVERLORD_HOST (default http://localhost:3173).

Examples:
  $PROG pin add https://hypatos.atlassian.net/browse/BACKEND-1234
  $PROG pin add https://github.com/hypatos/repo/pull/30 --title "Fix retries"
  $PROG pin add https://github.com/hypatos/repo/tree/feat/x --room
  $PROG todo add "Update the README"
  $PROG todo add --agent "Re-run the flaky test"
  $PROG todo ls --agent
  $PROG todo done pin-mabc12-x7k2qd
  $PROG room ls
  $PROG room move knowledge-service
EOF
}

die() { echo "$PROG: $*" >&2; exit "${EXIT:-1}"; }

# --- target resolution -------------------------------------------------------
# Prints a JSON object fragment identifying the session, e.g. {"ptyId": "..."}.
SESSION_OVERRIDE=""
target_json() {
  if [ -n "$SESSION_OVERRIDE" ]; then
    python3 -c 'import json,sys; print(json.dumps({"overlordId": sys.argv[1]}))' "$SESSION_OVERRIDE"; return
  fi
  if [ -n "$OVERLORD_PTY_ID" ]; then
    python3 -c 'import json,sys; print(json.dumps({"ptyId": sys.argv[1]}))' "$OVERLORD_PTY_ID"; return
  fi
  # Walk up the process tree: the first ancestor Overlord can resolve wins.
  local pid=$PPID i=0 out
  while [ -n "$pid" ] && [ "$pid" -gt 1 ] && [ $i -lt 8 ]; do
    out=$(curl -fsS "$BASE/api/resolve?pid=$pid" 2>/dev/null)
    if [ -n "$out" ]; then
      printf '%s' "$out" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(json.dumps({"overlordId": d["overlordId"]}))' && return
    fi
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    i=$((i + 1))
  done
  EXIT=2 die "cannot identify this session (no OVERLORD_PTY_ID, no known ancestor). Use --session <overlordId>."
}

# JSON object → query string.
to_query() { python3 -c 'import json,sys,urllib.parse; print(urllib.parse.urlencode(json.loads(sys.argv[1])))' "$1"; }

# Merge two JSON objects.
merge() { python3 -c 'import json,sys; a=json.loads(sys.argv[1]); a.update(json.loads(sys.argv[2])); print(json.dumps(a))' "$1" "$2"; }

# curl wrapper: prints body, fails with the server's error message on non-2xx.
call() {
  local method=$1 path=$2 data=$3 out code
  if [ -n "$data" ]; then
    out=$(curl -sS -w '\n%{http_code}' -X "$method" "$BASE$path" -H 'Content-Type: application/json' --data-binary "$data" 2>&1)
  else
    out=$(curl -sS -w '\n%{http_code}' -X "$method" "$BASE$path" 2>&1)
  fi
  [ $? -eq 0 ] || EXIT=2 die "cannot reach Overlord at $BASE — is the server running?"
  code=${out##*$'\n'}
  out=${out%$'\n'*}
  case $code in
    2??) printf '%s' "$out" ;;
    *) msg=$(printf '%s' "$out" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("error",""))
except Exception: print("")' 2>/dev/null)
       die "HTTP $code${msg:+: $msg}" ;;
  esac
}

# --- commands ----------------------------------------------------------------
cmd_whoami() {
  local t; t=$(target_json) || exit $?
  local r; r=$(call GET "/api/resolve?$(to_query "$t" | sed 's/overlordId=/ptyId=/')") || exit $?
  printf '%s' "$r" | python3 -c '
import json,sys; d=json.load(sys.stdin)
print("overlordId  %s\nsessionId   %s\ncwd         %s" % (d["overlordId"], d["sessionId"], d["cwd"]))'
}

cmd_pin() {
  local sub=$1; shift || true
  local room="" title="" kind="" pos=""
  while [ $# -gt 0 ]; do
    case $1 in
      --room) room=1 ;;
      --title) [ $# -ge 2 ] || die "--title needs a value"; title=$2; shift ;;
      --kind) [ $# -ge 2 ] || die "--kind needs a value"; kind=$2; shift ;;
      --session) [ $# -ge 2 ] || die "--session needs a value"; SESSION_OVERRIDE=$2; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$pos" ] || die "unexpected argument: $1"; pos=$1 ;;
    esac
    shift
  done
  local t; t=$(target_json) || exit $?
  # "1", not JSON true: urlencode turns True into "True" in query strings.
  [ -n "$room" ] && t=$(merge "$t" '{"room": "1"}')

  case $sub in
    add)
      [ -n "$pos" ] || die "usage: $PROG pin add <url> [--title T] [--kind K] [--room]"
      local body; body=$(python3 -c '
import json,sys
d={"url": sys.argv[1]}
if sys.argv[2]: d["title"]=sys.argv[2]
if sys.argv[3]: d["kind"]=sys.argv[3]
print(json.dumps(d))' "$pos" "$title" "$kind")
      local r; r=$(call POST /api/pins "$(merge "$t" "$body")") || exit $?
      printf '%s' "$r" | python3 -c '
import json,sys; d=json.load(sys.stdin); p=d["pin"]; t=d["target"]
where = "room " + t["room"] if "room" in t else t["overlordId"]
print("pinned %s  [%s] %s  -> %s" % (p["id"], p["kind"], p["title"], where))' ;;
    ls|list)
      local r; r=$(call GET "/api/pins?$(to_query "$t")") || exit $?
      printf '%s' "$r" | python3 -c '
import json,sys; d=json.load(sys.stdin)
if not d["pins"]: print("no pins")
for p in d["pins"]: print("\t".join([p["id"], p["kind"], p["title"], p["url"]]))' ;;
    rm|remove)
      [ -n "$pos" ] || die "usage: $PROG pin rm <pinId> [--room]"
      call DELETE "/api/pins/$pos?$(to_query "$t")" >/dev/null || exit $?
      echo "removed $pos" ;;
    ""|-h|--help|help) usage ;;
    *) die "unknown pin command: $sub (add|ls|rm)" ;;
  esac
}

cmd_todo() {
  local sub=$1; shift || true
  local room="" text="" owner=""
  while [ $# -gt 0 ]; do
    case $1 in
      --room) room=1 ;;
      --agent) owner=agent ;;
      --user) owner=user ;;
      --session) [ $# -ge 2 ] || die "--session needs a value"; SESSION_OVERRIDE=$2; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option: $1" ;;
      *) text="${text:+$text }$1" ;;
    esac
    shift
  done
  local t; t=$(target_json) || exit $?
  [ -n "$room" ] && t=$(merge "$t" '{"room": "1"}')

  case $sub in
    add)
      [ -n "$text" ] || die "usage: $PROG todo add <text> [--room]"
      local body; body=$(python3 -c 'import json,sys; print(json.dumps({"kind": "todo", "url": "", "text": sys.argv[1], "owner": sys.argv[2] or "user"}))' "$text" "$owner")
      local r; r=$(call POST /api/pins "$(merge "$t" "$body")") || exit $?
      printf '%s' "$r" | python3 -c 'import json,sys; p=json.load(sys.stdin)["pin"]; print("added %s  @%s  %s" % (p["id"], p.get("owner") or "user", p["text"]))' ;;
    ls|list)
      local r; r=$(call GET "/api/pins?$(to_query "$t")") || exit $?
      printf '%s' "$r" | python3 -c '
import json,sys
want=sys.argv[1]
todos=[p for p in json.load(sys.stdin)["pins"] if p["kind"]=="todo" and (not want or (p.get("owner") or "user")==want)]
if not todos: print("no TODOs")
for p in todos: print("%s\t[%s] @%-5s %s" % (p["id"], "x" if p.get("done") else " ", p.get("owner") or "user", p["text"]))' "$owner" ;;
    assign)
      local id=${text%% *} who=${text#* }
      { [ -n "$id" ] && [ "$id" != "$text" ]; } || who=$owner
      case $who in agent|user) ;; *) die "usage: $PROG todo assign <id> agent|user [--room]" ;; esac
      call PATCH "/api/pins/$id?$(to_query "$t")" "{\"owner\": \"$who\"}" >/dev/null || exit $?
      echo "assigned $id to $who" ;;
    done|undo)
      [ -n "$text" ] || die "usage: $PROG todo $sub <id> [--room]"
      local done=true; [ "$sub" = undo ] && done=false
      call PATCH "/api/pins/$text?$(to_query "$t")" "{\"done\": $done, \"by\": \"agent\"}" >/dev/null || exit $?
      [ "$sub" = done ] && echo "checked $text" || echo "unchecked $text" ;;
    rm|remove)
      [ -n "$text" ] || die "usage: $PROG todo rm <id> [--room]"
      call DELETE "/api/pins/$text?$(to_query "$t")" >/dev/null || exit $?
      echo "removed $text" ;;
    ""|-h|--help|help) usage ;;
    *) die "unknown todo command: $sub (add|ls|assign|done|undo|rm)" ;;
  esac
}

cmd_room() {
  local sub=$1; shift || true
  local home="" pos=""
  while [ $# -gt 0 ]; do
    case $1 in
      --home) home=1 ;;
      --session) [ $# -ge 2 ] || die "--session needs a value"; SESSION_OVERRIDE=$2; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option: $1" ;;
      *) pos="${pos:+$pos }$1" ;;
    esac
    shift
  done

  case $sub in
    ls|list)
      # Best effort: outside a session there is simply no room to mark.
      local mine="" t
      if t=$(target_json 2>/dev/null); then
        mine=$(curl -fsS "$BASE/api/resolve?$(to_query "$t" | sed 's/overlordId=/ptyId=/')" 2>/dev/null \
          | python3 -c 'import json,sys; print(json.load(sys.stdin).get("roomCwd",""))' 2>/dev/null)
      fi
      local r; r=$(call GET /api/rooms) || exit $?
      printf '%s' "$r" | python3 -c '
import json,sys
mine=sys.argv[1]
rooms=json.load(sys.stdin)["rooms"]
if not rooms: print("no rooms")
for r in rooms:
    print("%s %s\t%s\t%d sessions\t%s" % ("*" if r["cwd"]==mine else " ", r["id"], r["name"], r["sessionCount"], r["cwd"]))' "$mine" ;;
    move|mv)
      { [ -n "$home" ] && [ -z "$pos" ]; } || { [ -z "$home" ] && [ -n "$pos" ]; } \
        || die "usage: $PROG room move <room> | --home"
      local t; t=$(target_json) || exit $?
      local body; body=$(python3 -c 'import json,sys; print(json.dumps({"room": None if sys.argv[1] else sys.argv[2]}))' "$home" "$pos")
      # Not through call(): a 409 carries the candidate rooms, worth printing.
      local out code
      out=$(curl -sS -w '\n%{http_code}' -X POST "$BASE/api/sessions/room" -H 'Content-Type: application/json' --data-binary "$(merge "$t" "$body")" 2>&1) \
        || EXIT=2 die "cannot reach Overlord at $BASE — is the server running?"
      code=${out##*$'\n'}; out=${out%$'\n'*}
      printf '%s' "$out" | python3 -c '
import json,sys
code=sys.argv[1]
try: d=json.load(sys.stdin)
except Exception: d={}
if code.startswith("2"):
    r=d["room"]
    print("%s room %s  (%s)" % ("back in" if d.get("home") else "moved to", r["name"], r["cwd"]))
    if not d.get("home"): print("still running in the same folder; undo: ovr room move --home")
    sys.exit(0)
print("ovr: HTTP %s: %s" % (code, d.get("error","")), file=sys.stderr)
for c in d.get("candidates") or []: print("  %s\t%s\t%s" % (c["id"], c["name"], c["cwd"]), file=sys.stderr)
sys.exit(1)' "$code" || exit 1 ;;
    ""|-h|--help|help) usage ;;
    *) die "unknown room command: $sub (ls|move)" ;;
  esac
}

cmd_mute() {
  local r
  case ${1:-status} in
    on|off) r=$(call PATCH /api/settings "{\"agentSpeechMuted\": $([ "$1" = on ] && echo true || echo false)}") || exit $? ;;
    status) r=$(call GET /api/settings) || exit $? ;;
    *) die "usage: $PROG mute on|off|status" ;;
  esac
  printf '%s' "$r" | python3 -c 'import json,sys; print("agents voice: %s" % ("muted" if json.load(sys.stdin).get("agentSpeechMuted") else "on"))'
}

case ${1:-help} in
  whoami) shift; while [ $# -gt 0 ]; do case $1 in --session) SESSION_OVERRIDE=$2; shift ;; esac; shift; done; cmd_whoami ;;
  pin) shift; cmd_pin "$@" ;;
  todo) shift; cmd_todo "$@" ;;
  room) shift; cmd_room "$@" ;;
  mute) shift; cmd_mute "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
